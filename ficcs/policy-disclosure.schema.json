{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcatster7.github.io/foreign-influence-evidence-observatory/schemas/ficcs-policy-disclosure-1.0.0.json",
  "title": "FICCS public claim disclosure",
  "type": "object",
  "additionalProperties": false,
  "required": ["ficcs_version", "record_id", "issuer", "published_at_utc", "claim", "labels", "attribution_authority", "uncertainty_statement", "correction_route", "institutional_action", "automatic_promotion_prohibited"],
  "properties": {
    "ficcs_version": { "const": "1.0.0-candidate" },
    "record_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
    "issuer": { "type": "string", "minLength": 1 },
    "published_at_utc": { "type": "string", "format": "date-time" },
    "supersedes_record_id": { "type": ["string", "null"] },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "subject", "unit", "platforms", "period", "asserted_constructs"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "unit": { "enum": ["account", "group", "campaign", "content", "feed", "audience", "platform", "other"] },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "period": { "type": "string", "minLength": 1 },
        "asserted_constructs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["O", "P", "A", "C", "D", "E", "R", "I"] } }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "evidence-label.schema.json" }
    },
    "attribution_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "authority_type", "scope"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "authority_type": { "enum": ["platform", "government", "researcher", "journalist", "court", "other"] },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "uncertainty_statement": { "type": "string", "minLength": 1 },
    "correction_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "contact", "version_history_url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "contact": { "type": "string", "minLength": 1 },
        "version_history_url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "institutional_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "basis", "severity"],
      "properties": {
        "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["none_descriptive", "account_enforcement", "content_enforcement", "public_attribution", "sanctions_or_diplomacy", "legislation_or_regulation", "resource_allocation", "public_warning", "other"] } },
        "basis": { "enum": ["none_descriptive", "recommended", "documented_taken", "both", "unclear"] },
        "severity": { "enum": ["low", "moderate", "high"] }
      }
    },
    "automatic_promotion_prohibited": { "const": true }
  }
}
