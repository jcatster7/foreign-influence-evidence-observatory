{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcatster7.github.io/foreign-influence-evidence-observatory/schemas/ficcs-claim-extraction-0.1.0.json",
  "title": "FICCS pre-coding atomic claim extraction",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "claim_family_id", "selection_slot_id", "corpus_role", "source", "claim", "extraction_status"],
  "properties": {
    "claim_id": { "type": "string", "pattern": "^ficcs_claim_[a-z0-9_]+$" },
    "claim_family_id": { "type": "string", "minLength": 1 },
    "selection_slot_id": { "type": "string", "pattern": "^ficcs_slot_(research|platform|government|journalism)_[0-9]{3}$" },
    "corpus_role": { "const": "primary" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "source_type", "title", "author_or_institution", "published_date", "retrieved_at_utc", "canonical_url", "locator", "source_sha256", "archive_url", "quote_word_count"],
      "properties": {
        "document_id": { "type": "string", "pattern": "^ficcs_doc_[a-z0-9_]+$" },
        "source_type": { "enum": ["research", "platform", "government", "journalism"] },
        "title": { "type": "string", "minLength": 1 },
        "author_or_institution": { "type": "string", "minLength": 1 },
        "published_date": { "type": "string", "format": "date" },
        "retrieved_at_utc": { "type": "string", "format": "date-time" },
        "canonical_url": { "type": "string", "pattern": "^https://" },
        "locator": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "archive_url": { "type": ["string", "null"] },
        "quote_word_count": { "type": "integer", "minimum": 1, "maximum": 25 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verbatim_excerpt", "paraphrase", "subject", "unit", "platform", "period", "asserted_constructs"],
      "properties": {
        "verbatim_excerpt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "paraphrase": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "unit": { "enum": ["account", "group", "campaign", "content", "feed", "audience", "platform", "other"] },
        "platform": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "period": { "type": "string", "minLength": 1 },
        "asserted_constructs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["O", "P", "A", "C", "D", "E", "R", "I"] } }
      }
    },
    "extraction_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "selected_at_utc", "claim_position_in_document", "claim_coding_started"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "selected_at_utc": { "type": "string", "format": "date-time" },
        "claim_position_in_document": { "type": "integer", "minimum": 1, "maximum": 5 },
        "claim_coding_started": { "const": false }
      }
    }
  }
}
